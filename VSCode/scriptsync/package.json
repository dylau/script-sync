{
  "name": "script-sync",
  "displayName": "script-sync",
  "description": "script-sync allows to run C# and Python (IronPython or CPython) in Rhino8 directly from VSCode.",
  "publisher": "ibois-epfl",
  "author": {
    "name": "Andrea Settimi",
    "email": "andrea.settimi@epfl.ch"},
  "icon": "logo/scriptsync_480.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibois-epfl/script-sync"
  },
  "version": "1.2.29",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:scriptsync.sendPath",
    "onCommand:scriptsync.toggleGH",
    "onCommand:scriptsync.selectInstance",
    "onCommand:scriptsync.clearInstance",
    "onCommand:scriptsync.listInstances"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scriptsync.sendPath",
        "title": "Send Message to TCP ScriptSync Server"
      },
      {
        "command": "scriptsync.toggleGH",
        "title": "Toggle Server vscode to listen to incoming GH messages"
      },
      {
        "command": "scriptsync.selectInstance",
        "title": "Select the Rhino Instance to Send To"
      },
      {
        "command": "scriptsync.clearInstance",
        "title": "Clear the Selected Rhino Instance"
      },
      {
        "command": "scriptsync.listInstances",
        "title": "List the Running Rhino Instances"
      }
    ],
    "keybindings": [
      {
          "command": "scriptsync.sendPath",
          "key": "f4",
          "mac": "f4",
          "when": "editorTextFocus"
      },
      {
          "command": "scriptsync.sendPath",
          "key": "ctrl+alt+r",
          "mac": "ctrl+alt+r",
          "when": "editorTextFocus"
      },
      {
          "command": "scriptsync.toggleGH",
          "key": "shift+f4",
          "mac": "shift+f4",
          "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "script-sync",
      "properties": {
        "scriptsync.defaultPort": {
          "type": "number",
          "default": 58258,
          "description": "TCP port used when no Rhino instance could be discovered in the registry. Rhino instances bind the first free port starting from 58258."
        },
        "scriptsync.instanceTimeout": {
          "type": "number",
          "default": 5000,
          "description": "Timeout in milliseconds when connecting to the selected Rhino instance."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8"
  }
}